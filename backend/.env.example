NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Groq API key (https://console.groq.com - free tier, no credit card needed).
GROQ_API_KEY=

# Groq model for meal generation (Llama 3.3 70B - fast, free, 14400 req/day).
GROQ_MODEL=llama-3.3-70b-versatile

# Rate limiting (per IP).
RATE_LIMIT_GENERATE_WINDOW_MS=120000
RATE_LIMIT_GENERATE_MAX=1
RATE_LIMIT_GLOBAL_PER_MIN=120

# Reserved for the future cloud phase (auth + database).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET=