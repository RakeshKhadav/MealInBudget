NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# OpenRouter API key (https://openrouter.ai - free models available, no credit card needed).
OPENROUTER_API_KEY=

# OpenRouter model for meal generation (free 55B MoE model).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Rate limiting (per IP).
RATE_LIMIT_GENERATE_WINDOW_MS=120000
RATE_LIMIT_GENERATE_MAX=1
RATE_LIMIT_GLOBAL_PER_MIN=120

# Reserved for the future cloud phase (auth + database).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET=