NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Real Gemini API key (Google AI Studio, free tier). Required - no mock mode.
GEMINI_API_KEY=

# Gemini model used for meal generation (2.5+ required - Interactions API; free tier gives 250 req/day vs 20 on 3.x).
GEMINI_MODEL=gemini-2.5-flash

# Rate limiting (per IP).
RATE_LIMIT_GENERATE_WINDOW_MS=120000
RATE_LIMIT_GENERATE_MAX=1
RATE_LIMIT_GLOBAL_PER_MIN=120

# Reserved for the future cloud phase (auth + database).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET=